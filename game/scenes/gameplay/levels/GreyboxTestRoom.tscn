theme_override_font_sizes/font_size = 13
text = "PROJECT: LOCKDOWN - CONTROLS
WASD / Left Stick: Move | LeftShift / L3: Sprint | Space / A: Jump
LeftCtrl / B: Crouch
Left Click / RT: Fire Pistol (25 dmg) | R / X: Reload
Hold RMB / LT: Block (Melee only) | Tap to Parry (0.25s -> Stun)
F / RB: Melee Attack (35 dmg, ShapeCast sweep)
E / Y: Contextual Interact (Ammo Stash / Medkit)
Escape / Start: Pause / Release Mouse (LMB: Recapture)
F1: Take 10 dmg | F2: Refill Ammo | F3: God Mode | F4: AI Overlay"
