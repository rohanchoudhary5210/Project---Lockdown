[gd_scene load_steps=6 format=3 uid="uid://cmedkit_pickup_001"]

[ext_resource type="Material" uid="uid://cmat_medkit_001" path="res://assets/placeholder/mat_medkit.tres" id="1_mat"]
[ext_resource type="Script" path="res://scripts/components/interactable_component.gd" id="2_interact"]

[sub_resource type="GDScript" id="GDScript_medkit"]
script/source = "extends StaticBody3D

@onready var interactable: InteractableComponent = $InteractableComponent
var is_looted: bool = false
const HEAL_AMOUNT: float = 35.0

func get_prompt() -> String:
	if is_looted:
		return \"\"
	var player = get_tree().get_first_node_in_group(\"player\")
	if player and player.health_component:
		if player.health_component.current_health >= player.health_component.max_health:
			return \"Health Full\"
	var im = get_node_or_null(\"/root/InputManager\")
	var key = im.get_action_key_label(\"interact\") if im else \"E\"
	return \"[%s] Pick Up Medkit (+%d HP)\" % [key, int(HEAL_AMOUNT)]

func interact(interactor: Node) -> void:
	if is_looted:
		return
	if interactor.has_method(\"heal\") and interactor.health_component:
		if interactor.health_component.current_health >= interactor.health_component.max_health:
			return # Do not consume if health is already full!
		interactor.heal(HEAL_AMOUNT)
		is_looted = true
		var am = get_node_or_null(\"/root/AudioManager\")
		if am and am.has_method(\"play_pickup\"):
			am.play_pickup()
		visible = false
		collision_layer = 0
		if interactable:
			interactable.is_interactable = false

func reset_pickup() -> void:
	is_looted = false
	visible = true
	collision_layer = 8
	if interactable:
		interactable.is_interactable = true
"

